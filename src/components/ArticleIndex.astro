---
import type { PaginationPage } from "../lib/pagination";
import type { ArticleEntry } from "../lib/articles";
import ArticleCard from "./ArticleCard.astro";
import Pagination from "./Pagination.astro";

type Props = {
  page: PaginationPage<ArticleEntry>;
};

const { page } = Astro.props;
---

<section class="page-section">
  <p class="page-kicker">{page.totalItems} saved article{page.totalItems === 1 ? "" : "s"}</p>
  <h1 class="page-title">Shared Article Catalogue</h1>
  <p class="page-intro">
    Articles worth keeping, arranged as static pages from Markdown source.
  </p>

  <div class="article-grid" data-testid="article-grid">
    {page.items.map((article) => <ArticleCard article={article} />)}
  </div>

  <Pagination page={page} />
</section>
