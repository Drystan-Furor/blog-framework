---
import { getArticleSlug, type ArticleEntry } from "../lib/articles";
import { getArticleImage } from "../lib/article-images";
import { createArticleCardView } from "../lib/component-contracts";

type Props = {
  article: ArticleEntry;
};

const { article } = Astro.props;
const slug = getArticleSlug(article);
const card = createArticleCardView(article);
const image = card.image ? getArticleImage(slug, card.image.path) : null;
---

<article class="article-card" data-testid="article-card">
  <a class="article-card__link" data-testid="article-card-link" href={card.href}>
    {
      image && (
        <img
          class="article-card__image"
          src={image.src}
          alt={card.image?.alt}
          width={image.width}
          height={image.height}
          loading="lazy"
          decoding="async"
        />
      )
    }
    <div class="article-card__body">
      <p class="article-card__meta">{card.publishedDate}</p>
      <h2 class="article-card__title">{card.title}</h2>
      <p class="article-card__summary">{card.summary}</p>
      <div class="article-card__details" aria-label="Article metadata">
        <p>Subject: {card.subject}</p>
        {card.tags.length > 0 && <p>Tags: {card.tags.join(", ")}</p>}
      </div>
    </div>
  </a>
</article>
